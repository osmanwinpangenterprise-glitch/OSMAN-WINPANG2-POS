rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Products collection: POS catalog read & management writes
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Settings collection: Business profile, currency, tax rates, receipt formatting
    match /settings/{document} {
      allow read, write: if true;
    }

    // Users & Staff Profiles collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customers & Credit Ledgers
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Suppliers & Purchase Orders
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Sales & Receipts collection
    match /sales/{saleId} {
      allow read, write: if true;

      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Purchases & Goods Receiving collection
    match /purchases/{purchaseId} {
      allow read, write: if true;

      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Operational Expenses collection
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Stock Movements & Valuation Audit Trail
    match /stockMovements/{movementId} {
      allow read, write: if true;
    }

    // Customer & Supplier Payments collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Cash Register Shifts & Sessions collection
    match /cashSessions/{sessionId} {
      allow read, write: if true;
    }

    // Parked / Held Sales collection
    match /heldSales/{heldSaleId} {
      allow read, write: if true;
    }

    // Audit Logs & Security History
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // System Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Counters for sequential invoice & receipt numbers
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Database connection test probe
    match /test/{document} {
      allow read, write: if true;
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
